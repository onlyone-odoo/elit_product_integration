<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elit_catalog_line_tree" model="ir.ui.view">
        <field name="name">elit.catalog.line.tree</field>
        <field name="model">elit.catalog.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="codigo"/>
                <field name="state"/>
                <field name="product_tmpl_id"/>
                <field name="error_message" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_elit_catalog_run_tree" model="ir.ui.view">
        <field name="name">elit.catalog.run.tree</field>
        <field name="model">elit.catalog.run</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="state"/>
                <field name="offset"/>
                <field name="line_count"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </tree>
        </field>
    </record>

    <record id="view_elit_catalog_run_form" model="ir.ui.view">
        <field name="name">elit.catalog.run.form</field>
        <field name="model">elit.catalog.run</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="offset"/>
                            <field name="line_count"/>
                        </group>
                        <group>
                            <field name="cotizacion"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_elit_catalog_run" model="ir.actions.act_window">
        <field name="name">ELIT catalog runs</field>
        <field name="res_model">elit.catalog.run</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_elit_catalog_run"
        name="ELIT catalog runs"
        parent="stock.menu_stock_root"
        action="action_elit_catalog_run"
        sequence="11"
        groups="base.group_system"
    />
</odoo>
