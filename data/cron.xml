<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Legacy crons removed: use trigger+batch+scheduled actions instead -->
    <delete model="ir.cron" id="cron_elit_update_stock_daily"/>
    <delete model="ir.cron" id="cron_elit_incremental"/>

    <!--
        Unified catalog staging (odoo-batched-api-sync):
        Trigger → ingest batch (1 API page) → apply batch (internal, no API)
        Cleanup deactivates ingest/apply (cron cannot deactivate itself).
    -->

    <record id="cron_elit_catalog_trigger" model="ir.cron">
        <field name="name">ELIT: Activar sync de catálogo (staging)</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._action_request_elit_catalog_sync()</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>

    <record id="cron_elit_catalog_ingest_batch" model="ir.cron">
        <field name="name">ELIT: Lotes ingest catálogo (1 página API)</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._cron_elit_catalog_ingest_batch()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
        <field name="priority">7</field>
    </record>

    <record id="cron_elit_catalog_apply_batch" model="ir.cron">
        <field name="name">ELIT: Lotes apply catálogo (interno)</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._cron_elit_catalog_apply_batch()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
        <field name="priority">8</field>
    </record>

    <!-- Previous dual API walks: kept for rollback, inactive. -->
    <record id="cron_elit_new_products" model="ir.cron">
        <field name="name">ELIT: Activar importación de productos nuevos (legacy)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._action_request_elit_new_products_sync()</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
        <field name="priority">15</field>
    </record>

    <record id="cron_elit_new_products_batch" model="ir.cron">
        <field name="name">ELIT: Lotes de importación productos nuevos (legacy)</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._cron_elit_new_products_batch()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
        <field name="priority">16</field>
    </record>

    <record id="cron_elit_price_stock_trigger" model="ir.cron">
        <field name="name">ELIT: Activar sync precio y stock (legacy)</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._action_request_elit_price_stock_sync()</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
        <field name="priority">17</field>
    </record>

    <record id="cron_elit_price_stock_batch" model="ir.cron">
        <field name="name">ELIT: Lotes de sync precio y stock (legacy)</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._cron_elit_price_stock_batch()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="False"/>
        <field name="priority">18</field>
    </record>

    <record id="cron_elit_deactivate_batch_if_pending" model="ir.cron">
        <field name="name">ELIT: Desactivar crons de lotes si corresponde</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._cron_elit_deactivate_batch_if_pending()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="priority">20</field>
    </record>

    <record id="cron_elit_sync_images" model="ir.cron">
        <field name="name">ELIT: Descargar imágenes (batch)</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model.sync_elit_images_batch(batch_size=20)</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="priority">20</field>
    </record>

    <record id="cron_auto_publish_elit" model="ir.cron">
        <field name="name">ELIT: Publicar productos con stock</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
# Publicar productos con stock > 5
to_publish = model.search([
    ('is_elit_product', '=', True),
    ('stock_elit', '>', 5),
    ('website_published', '=', False),
])
if to_publish:
    to_publish.write({'website_published': True})

# Despublicar productos sin stock
to_unpublish = model.search([
    ('is_elit_product', '=', True),
    ('stock_elit', '=', 0),
    ('website_published', '=', True),
])
if to_unpublish:
    to_unpublish.write({'website_published': False})
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="priority">15</field>
    </record>

    <record id="cron_elit_api_health_check" model="ir.cron">
        <field name="name">ELIT: Health check API</field>
        <field name="model_id" ref="model_elit_sync_processor"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_elit_api_health()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
        <field name="priority">25</field>
    </record>
</odoo>
