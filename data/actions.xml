<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Acción para pocos productos (1 llamada API por producto) -->
    <record id="action_update_single_stock_elit" model="ir.actions.server">
        <field name="name">ELIT: Actualizar Stock (individual)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">records.update_single_stock_elit()</field>
    </record>

    <!-- Acción batch para muchos productos (muy eficiente) -->
    <record id="action_update_stock_batch" model="ir.actions.server">
        <field name="name">ELIT: Actualizar Stock BATCH (eficiente)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
if records:
    env['product.template'].update_stock_batch(
        domain=[('id', 'in', records.ids)],
        commit_interval=50,
    )
        </field>
    </record>

    <!-- Acción para actualizar TODOS los productos ELIT -->
    <record id="action_update_all_elit_stock" model="ir.actions.server">
        <field name="name">ELIT: Actualizar TODOS los Stock (batch)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
env['elit.sync.processor'].update_all_elit_stock_and_cost()
        </field>
    </record>

    <!-- Acción para importar solo productos nuevos -->
    <record id="action_sync_new_products" model="ir.actions.server">
        <field name="name">ELIT: Importar Productos Nuevos</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
env['elit.sync.processor'].sync_new_products_only()
        </field>
    </record>

    <!-- Acción "fix this product": re-consulta la API por 1 producto y descarga imagen -->
    <record id="action_elit_refresh_product" model="ir.actions.server">
        <field name="name">ELIT: Reparar datos e imagen (1 producto)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">records.elit_refresh_from_api()</field>
    </record>
</odoo>